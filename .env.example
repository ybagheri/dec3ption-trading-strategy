# === MetaTrader 5 Terminal === | مسیر ترمینال متاتریدر
MT5_PATH=C:\Program Files\Alpari MT5_2\terminal64.exe
MT5_DATA_FOLDER=C:\Users\BazikadeStore\AppData\Roaming\MetaQuotes\Terminal\AF19ECCF568F855DF9D3196BBF8BF315
# Optional auto-login (leave empty to use the already-logged-in terminal)
# ورود خودکار (خالی بگذارید تا از ترمینال لاگین‌شده استفاده شود)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=60000

# === Markets === | نمادها و تایم‌فریم‌ها (comma-separated)
SYMBOLS=US30,NAS100,US500,XAUUSD,BTCUSD,EURUSD
TIMEFRAMES=M1,M5

# === Risk (user-tunable) === | ریسک (قابل تنظیم توسط کاربر)
RISK_PCT=0.5
MAX_DAILY_LOSS_PCT=1.0
MAX_TRADES_PER_DAY=3

# === Buffer rule: max(SPREAD_MULT * spread, RANGE_FRACTION * range_height) ===
# قانون بافر: بیشترِ (ضریب × اسپرد، کسر × ارتفاع رنج)
BUFFER_SPREAD_MULT=2.0
BUFFER_RANGE_FRACTION=0.1

# === TP ladder (multiples of 1R; 1R = range height) === | نردبان تارگت (مضرب ریسک)
TP_LADDER=1,3,6,9,10,18,24,40,66,90
TP1_MOVE_TO_BREAKEVEN=true
TP3_PARTIAL_CLOSE_PCT=30.0

# === Execution === | اجرا
MAGIC_NUMBER=32026
DRY_RUN=true
